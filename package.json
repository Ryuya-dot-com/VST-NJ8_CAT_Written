{
  "name": "web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run lint && npm run test && npm run verify:bank && npm run verify:range && npm run verify:simulation && npm run verify:estimators && npm run verify:exposure && npm run build",
    "diagnose:bank": "node scripts/diagnose-bank.ts",
    "diagnose:range": "node scripts/diagnose-measurement-range.ts",
    "lint": "eslint .",
    "evaluate:simulation": "node scripts/evaluate-confirmation.ts",
    "simulate": "node scripts/simulate-cat.ts",
    "simulate:estimators": "node scripts/simulate-estimator-sensitivity.ts",
    "simulate:exposure": "node scripts/simulate-exposure-control.ts",
    "test": "node --test tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.ts",
    "verify:bank": "node scripts/diagnose-bank.ts --plan=simulation/plans/bank-diagnostic-v1.json --expected=simulation/results/bank-diagnostic-v1.json",
    "verify:range": "node scripts/diagnose-measurement-range.ts --plan=simulation/plans/measurement-range-diagnostic-v1.json --expected=simulation/results/measurement-range-diagnostic-v1.json",
    "verify:estimators": "node scripts/verify-estimator-sensitivity.ts",
    "verify:exposure": "node scripts/verify-exposure-control.ts",
    "verify:simulation": "node scripts/evaluate-confirmation.ts --report=simulation/results/confirmation-v1.json --expected=simulation/results/confirmation-v1-evaluation.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
